# Copy this file to .env and fill in real values. Never commit the real .env.

# ─── Core ──────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/bitimax
PORT=3001
NODE_ENV=development

# ─── Telegram ──────────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=
# Numeric chat id of the platform owner. Receives every alert.
ADMIN_CHAT_ID=
# Optional extra admins/moderators, comma separated telegram ids.
ADMIN_IDS=
BOT_USERNAME=bitimax_bot
SUPPORT_USERNAME=bitimax_admin

# ─── Secrets ───────────────────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Shared secret the SMS-forwarding app must send in every /api/sms-webhook request.
WEBHOOK_SECRET=

# Shared secret required (as the x-internal-key header) to call the internal
# escrow/transactions API. Only the bot process should hold this value.
INTERNAL_API_KEY=

# 32-byte key (64 hex chars) that encrypts account credentials and payout cards at rest.
# LOSING THIS MAKES EVERY STORED CREDENTIAL UNREADABLE. Back it up outside the repo, and
# never rotate it without re-encrypting existing records first.
ENCRYPTION_KEY=

# ─── Money ─────────────────────────────────────────────────────────────────────
# Platform commission, in percent, taken from the seller on settled value only.
PLATFORM_COMMISSION=7

# Bank cards buyers transfer into, as JSON. Spreading turnover across several cards keeps any
# one card below the daily limits that get personal cards frozen.
# PAYMENT_CARDS=[{"id":"card1","number":"8600123456789012","holder":"ISMOILOV A","bank":"Kapitalbank","active":true}]
PAYMENT_CARDS=[]

# Minutes a buyer has to transfer the unique amount before the reservation lapses.
PAYMENT_WINDOW_MINUTES=10
# Hours after the buyer opens the credentials before escrow auto-releases to the seller.
AUTO_RELEASE_HOURS=24
# Hours before an order whose credentials were NEVER opened is auto-refunded in full.
UNREVEALED_GRACE_HOURS=72

# Withdrawals
MIN_PAYOUT_AMOUNT=10000
PAYOUT_FEE_FLAT=0

# Refunds in a rolling 30 days before a buyer loses automatic refunds and is routed to
# manual arbitration instead. The main defence against refund farming.
REFUND_ABUSE_THRESHOLD=3

# Days after an order settles before stored credentials are wiped.
CREDENTIAL_RETENTION_DAYS=30

# Optional override of the refund policy table. Ordered; the last tier must have
# "withinMinutes": null as the catch-all. penaltyPercent is what the buyer forfeits, so the
# buyer always receives exactly (100 - penaltyPercent)%.
# REFUND_TIERS=[{"id":"0-10min","label":"0–10 daqiqa","withinMinutes":10,"penaltyPercent":0,"allowed":true},{"id":"10min-2h","label":"10 daqiqa – 2 soat","withinMinutes":120,"penaltyPercent":10,"allowed":true},{"id":"2h-24h","label":"2 – 24 soat","withinMinutes":1440,"penaltyPercent":50,"allowed":true},{"id":"over24h","label":"24 soatdan keyin","withinMinutes":null,"penaltyPercent":100,"allowed":false}]

# ─── Web / API ─────────────────────────────────────────────────────────────────
SITE_URL=https://bitimax.uz
# Comma-separated browser origins allowed to call the public API.
CORS_ORIGINS=http://localhost:3000

# Optional: comma-separated allowlist of trusted SMS sender ids/shortcodes.
# Leave empty to accept any sender (current default behavior).
SMS_ALLOWED_SENDERS=

# ─── Scale ─────────────────────────────────────────────────────────────────────
# Set to false on every replica except one, so only a single instance runs the
# expiry / auto-release / reconciliation sweeps.
JOBS_ENABLED=true

# Sinov uchun: bitta akkaunt ham sotuvchi, ham xaridor bo'la olsin.
# Ishlab chiqarishda O'CHIRIB QO'YING — o'zidan sotib olish faqat 7% komissiyaga tushadi,
# lekin sellerStats.sold ni oshiradi, ya'ni ishonch darajasini va narx chegarasini
# sun'iy ko'tarish yo'lini ochadi.
ALLOW_SELF_PURCHASE=false
